{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "playwright": {
      "command": "/Users/ssidhu/.local/node/bin/npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {
        "PATH": "/Users/ssidhu/.local/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "modus-docs": {
      "command": "/Users/ssidhu/.local/node/bin/npx",
      "args": [
        "-y",
        "@trimble-oss/moduswebcomponents-mcp@latest"
      ],
      "env": {
        "PATH": "/Users/ssidhu/.local/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
